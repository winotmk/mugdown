{
  "name": "mugdown",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "description": "A small, document-first Markdown editor for Windows and macOS",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/collect-licenses.mjs",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "tauri build",
    "package:win": "tauri build --target x86_64-pc-windows-msvc",
    "package:mac": "tauri build --target universal-apple-darwin",
    "check:ui": "node scripts/ui-v022-smoke.cjs && node scripts/window-drag-ui-smoke.cjs && node scripts/settings-ui-smoke.cjs && node scripts/editor-v025-smoke.cjs && node scripts/floating-ui-smoke.cjs"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/open-sans-condensed": "^4.5.5",
    "@milkdown/crepe": "7.22.3",
    "@milkdown/kit": "7.22.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.468.0",
    "markdown-it": "^15.0.3",
    "markdown-it-deflist": "^4.0.0",
    "mdast-util-from-markdown": "^2.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "^4.0.0",
    "playwright": "^1.56.0"
  }
}
